<?xml version="1.0" encoding="utf-8"?>
<!-- Ice: a frosty top-to-bottom fade from E0F7FF to 7DD3FC. Most cast and file-transfer apps use a
     saturated blue tile, so the pale tile with a deep-blue mark stands apart. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90"
                android:startColor="#E0F7FF"
                android:endColor="#7DD3FC" />
        </aapt:attr>
    </path>
</vector>
